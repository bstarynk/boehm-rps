#include "boehmrps.h"

struct brps_carbparse_stack;

%header%
struct brps_carbparse_stack;
#pragma message "header part of carbparse.cbrt in boehm-rps"
extern void brps_carbparse_stack_init(struct bprs_carbparse_stack *stack);
extern void brps_carbparse_stack_cleanup(struct bprs_carbparse_stack *stack);
extern int brps_carbparse_lex(struct brps_carbparse_stack *stack);
extern int brps_carbparse_scan(struct brps_carbparse_stack *stack);
extern int brps_carbparse_parse(struct brps_carbparse_stack *stack, int sym);
%%


%scanner%

%prefix brps_carbparse_

%token INT

%type INT: intptr_t

%token DOUBLE

%type DOUBLE: double

INT: [\+\-]?[0-9]+ {
 _Pragma("message \"got Int\"");
 $$ = atoll($text);
}

DOUBLE:  [\+\-]?[0-9]+[\.][0-9]* {
 _Pragma("message \"got Double\"");
 $$ = atof($text);
}


: [\ \t\r\f]+; 			/*skip whitespace*/

//: [\n] { _Pragma("message \"got newline\""); };

%grammar%

%%
_Pragma("message \"end carbparse.cbrt in boehm-gc\"");

/****************
 **                           for Emacs...
 ** Local Variables: ;;
 ** compile-command: "make -j3" ;;
 ** End: ;;
 ****************/

/* end of file boehm-rps/carbparse.cbrt */